# ==========================================================================
# LandLead — environment configuration
# Copy to `.env` and fill in as needed. NOTHING here is required to run the
# core system; every key below is OPTIONAL and gates an optional integration.
# ==========================================================================

# --- Database ---------------------------------------------------------------
# Default is a local SQLite file. Point at Postgres by setting a DSN, e.g.
# DATABASE_URL=postgresql://user:pass@localhost:5432/landlead
DATABASE_URL=sqlite:///./landlead.db

# --- Scraper politeness -----------------------------------------------------
# Identify your crawler honestly. Include a contact address so site operators
# can reach you. Do NOT impersonate a browser to evade bot protection.
SCRAPER_USER_AGENT=LandLeadBot/1.0 (+mailto:jowensrealtor@gmail.com)
SCRAPER_RATE_LIMIT_SECONDS=3.0        # min delay between requests to one host
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_RESPECT_ROBOTS=true           # honor robots.txt (keep true)

# --- Optional: licensed / ToS-restricted data sources -----------------------
# These are DISABLED by default. Only enable a source you are licensed and
# permitted to access. See COMPLIANCE.md before turning any of these on.
ENABLE_OBITUARY_ADAPTER=false         # Legacy.com / Newspapers.com — ToS-restricted
ENABLE_USPS_VACANCY=false             # NCOA/vacancy — requires USPS licensee
USPS_API_KEY=                         # optional, licensed only

# --- Optional: skip-trace connectors (permissible purpose required) ---------
# Real-estate marketing is generally a permissible purpose under GLBA/DPPA,
# but you are responsible for confirming that with your vendor and counsel.
SKIPTRACE_PROVIDER=                   # tlo | batchskiptracing | idi | (blank = disabled)
TLO_API_KEY=
BATCHSKIPTRACING_API_KEY=
IDI_API_KEY=

# --- Scheduler --------------------------------------------------------------
ENABLE_SCHEDULER=true
