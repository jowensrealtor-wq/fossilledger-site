# TikTok Shop Partner / Open API credentials (required for any live pull).
# Get these from partner.tiktokshop.com after creating an app and
# completing creator authorization. Without them the framework refuses to
# produce data — there is no demo/synthetic mode by design.
TTS_APP_KEY=
TTS_APP_SECRET=
TTS_ACCESS_TOKEN=

# Role: affiliate (default) or seller. Affiliate mode uses the
# Affiliate Creator API surface (marketplace products, commission,
# your affiliate orders) and does not need a shop cipher.
# TTS_ROLE=affiliate

# Seller mode only:
TTS_SHOP_CIPHER=

# Optional: enables automatic access-token refresh (not yet wired).
TTS_REFRESH_TOKEN=

# Optional overrides.
# TTS_API_BASE=https://open-api.tiktokglobalshop.com
# TTS_AUTH_BASE=https://auth.tiktok-shops.com

# Optional: lets the script engine generate finished prose itself.
# Without it, `intel script` emits a grounded script brief instead.
ANTHROPIC_API_KEY=
